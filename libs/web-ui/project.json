{
  "name": "web-ui",
  "$schema": "../../node_modules/nx/schemas/project.json",
  "sourceRoot": "libs/web-ui/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:shared"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run libs/web-ui --passWithNoTests --config vitest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"libs/web-ui/**/*.ts\"",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
