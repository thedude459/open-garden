# Base images are pinned by digest; Dependabot (docker ecosystem) bumps them.

# Build: install everything, then bundle the API and boot scripts with esbuild.
# Build once on the runner's own platform; the output (JS and static files) runs anywhere.
FROM --platform=$BUILDPLATFORM node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN node scripts/docker/build-api.mjs

# Runtime: the bundle, the SQL migrations, the pinned plant catalog, and the entrypoint. No node_modules,
# no TypeScript tooling, no source tree. Runs as the unprivileged `node` user (uid 1000).
FROM node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS runtime
ENV NODE_ENV=production \
    NODE_OPTIONS=--enable-source-maps \
    COOKIE_SECURE=false \
    PORT=3000
WORKDIR /app
# Apply Debian security fixes released after the pinned base image was built,
# as Dockerfile.web does with apk (ADR 0041). CI passes today's date, so this
# layer is rebuilt daily instead of being reused from the build cache.
ARG OS_PACKAGES_DATE=unset
RUN echo "OS packages as of ${OS_PACKAGES_DATE}" \
    && apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
# npm, npx, and corepack ship with the base image but are never used at runtime;
# removing them drops their bundled dependencies from the attack surface.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
COPY --from=build --chown=root:root /app/dist/api-runtime ./dist
COPY --chown=root:root libs/plant-catalog-data/migrations ./libs/plant-catalog-data/migrations
COPY --chown=root:root libs/plant-provider/catalog ./libs/plant-provider/catalog
COPY --chown=root:root scripts/docker/api-entrypoint.sh ./api-entrypoint.sh
USER 1000:1000
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=6 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["sh", "/app/api-entrypoint.sh"]
