# Base images are pinned by digest; Dependabot (docker ecosystem) bumps them.

# Build once on the runner's own platform; the output (JS and static files) runs anywhere.
FROM --platform=$BUILDPLATFORM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
ENV NX_DAEMON=false
RUN npx nx build web --configuration=production

# Runtime: static files behind nginx running as the unprivileged nginx user (uid 101).
FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
# Apply Alpine security fixes released after the pinned base image was built.
# CI passes today's date, so this layer is rebuilt daily instead of being
# reused from the build cache with stale packages.
ARG OS_PACKAGES_DATE=unset
USER 0
RUN echo "OS packages as of ${OS_PACKAGES_DATE}" && apk upgrade --no-cache
USER 101:101
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/web/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /app/dist/web/browser /usr/share/nginx/html
EXPOSE 8080
