{
  "name": "garden-place",
  "$schema": "../../node_modules/nx/schemas/project.json",
  "sourceRoot": "libs/garden-place/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:gardens", "layer:domain"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run libs/garden-place --passWithNoTests --config vitest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"libs/garden-place/**/*.ts\"",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
