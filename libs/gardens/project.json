{
  "name": "gardens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/gardens/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:gardens", "layer:domain"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run libs/gardens --passWithNoTests --config vitest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"libs/gardens/**/*.ts\"",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
