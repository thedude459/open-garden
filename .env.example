# Local development and Compose local testing only — not NAS production.
# NAS: inject POSTGRES_PASSWORD, SESSION_SECRET, and WEB_HOST=0.0.0.0 in the
# NAS Docker UI. Do not commit a production .env.

# Host workflow (npm run api:serve): API on this machine talks to Postgres on localhost.
# The api container ignores this value and uses hostname postgres (see docker-compose.yml).
DATABASE_URL=postgresql://open_garden:open_garden@localhost:5432/open_garden

# Local testing only. NAS injects a real secret; do not commit production values.
SESSION_SECRET=dev-only-change-me-in-production

PORT=3000
CORS_ORIGIN=http://localhost:4200
PLANT_PROVIDER=fixture
# PERENUAL_API_KEY=

# Session cookie Secure flag. Default false so HTTP NAS / local stack can sign in.
# Set true only behind TLS (out of scope). NODE_ENV=production does not imply Secure.
COOKIE_SECURE=false

# Stacked web bind (docker compose --profile app). Host nx serve still uses :4200.
WEB_HOST=127.0.0.1
WEB_PORT=8080
