{
  "name": "plant-catalog-data",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/plant-catalog-data/src",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:plant",
    "layer:data-access"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run libs/plant-catalog-data --passWithNoTests --config vitest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"libs/plant-catalog-data/**/*.ts\"",
        "cwd": "{workspaceRoot}"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit migrate --config=libs/plant-catalog-data/drizzle.config.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
