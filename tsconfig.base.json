{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@open-garden/shared-types": ["libs/shared-types/src/index.ts"],
      "@open-garden/plant-catalog": ["libs/plant-catalog/src/index.ts"],
      "@open-garden/plant-provider": ["libs/plant-provider/src/index.ts"],
      "@open-garden/plant-favorites": ["libs/plant-favorites/src/index.ts"],
      "@open-garden/plant-catalog-data": ["libs/plant-catalog-data/src/index.ts"],
      "@open-garden/auth": ["libs/auth/src/index.ts"],
      "@open-garden/gardens": ["libs/gardens/src/index.ts"],
      "@open-garden/planting-calendar": ["libs/planting-calendar/src/index.ts"],
      "@open-garden/planting-calendar/this-week": ["libs/planting-calendar/src/lib/this-week.ts"],
      "@open-garden/seasonal-plantings": ["libs/seasonal-plantings/src/index.ts"],
      "@open-garden/seasonal-plantings/dates": ["libs/seasonal-plantings/src/lib/dates.ts"],
      "@open-garden/seasonal-plantings/beds": ["libs/seasonal-plantings/src/lib/beds.ts"],
      "@open-garden/seasonal-plantings/group-plantings": [
        "libs/seasonal-plantings/src/lib/group-plantings.ts"
      ],
      "@open-garden/garden-layout": ["libs/garden-layout/src/index.ts"],
      "@open-garden/garden-layout/evaluate": [
        "libs/garden-layout/src/lib/evaluate-layout.ts"
      ],
      "@open-garden/garden-layout/rotate": ["libs/garden-layout/src/lib/rotate.ts"],
      "@open-garden/care-reminders": ["libs/care-reminders/src/index.ts"],
      "@open-garden/care-reminders/derive": ["libs/care-reminders/src/lib/derive-export.ts"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
