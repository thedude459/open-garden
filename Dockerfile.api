# Base images are pinned by digest; Dependabot (docker ecosystem) bumps them.

# Build: install everything, then bundle the API and boot scripts with esbuild.
FROM node:26-bookworm-slim@sha256:add5c17c14752c54d2f3d519ec46a3815684d41c33f198bcb09fb998f7dcbf68 AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --ignore-scripts
COPY . .
RUN node scripts/docker/build-api.mjs

# Runtime: the bundle, the SQL migrations, and the entrypoint. No node_modules,
# no TypeScript tooling, no source tree. Runs as the unprivileged `node` user (uid 1000).
FROM node:26-bookworm-slim@sha256:add5c17c14752c54d2f3d519ec46a3815684d41c33f198bcb09fb998f7dcbf68 AS runtime
ENV NODE_ENV=production \
    NODE_OPTIONS=--enable-source-maps \
    COOKIE_SECURE=false \
    PORT=3000
WORKDIR /app
# npm, npx, and corepack ship with the base image but are never used at runtime;
# removing them drops their bundled dependencies from the attack surface.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
COPY --from=build --chown=root:root /app/dist/api-runtime ./dist
COPY --chown=root:root libs/plant-catalog-data/migrations ./libs/plant-catalog-data/migrations
COPY --chown=root:root scripts/docker/api-entrypoint.sh ./api-entrypoint.sh
USER 1000:1000
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=6 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["sh", "/app/api-entrypoint.sh"]
