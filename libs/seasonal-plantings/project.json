{
  "name": "seasonal-plantings",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/seasonal-plantings/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:plantings", "layer:domain"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run libs/seasonal-plantings --passWithNoTests --config vitest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"libs/seasonal-plantings/**/*.ts\"",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
