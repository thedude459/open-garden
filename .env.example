# Local development and demo only — not for a garden people rely on.
# For a real install see README.md (Install with Docker) and docs/deploy.md.
# Do not commit a production .env.

# Host workflow (npm run api:serve): API on this machine talks to Postgres on localhost.
# The api container ignores this value and uses hostname postgres (see docker-compose.yml).
DATABASE_URL=postgresql://open_garden:open_garden@localhost:5432/open_garden

# Local/demo only: creates gardener@example.com and admin@example.com
# (password123). Never set this for a garden other people rely on.
SEED_DEMO_USERS=true

PORT=3000
CORS_ORIGIN=http://localhost:4200
PLANT_PROVIDER=fixture
# PERENUAL_API_KEY=

# fixture skips vendor calls. live uses Nominatim and OpenStreetMap for the
# garden place, plus phzmapi, FarmSense, and Open-Meteo. No map API key.
PLACE_PROVIDER=fixture

# Session cookie Secure flag. false for local HTTP; set true when people reach
# the app over HTTPS (the web container does not forward the browser's scheme).
COOKIE_SECURE=false

# Stacked web bind (docker compose --profile app). Host nx serve still uses :4200.
WEB_HOST=127.0.0.1
WEB_PORT=8080
